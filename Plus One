class Solution {
    public int[] plusOne(int[] digits) {
        
            int digitCount = digits.length;

            for(int i = digitCount-1; i>=0 ; i--){
                if(digits[i] < 9){
                    digits[i]++;
                    return digits;
                }
                digits[i] = 0;
            }
            int[] result = new int[digitCount+1];

            result[0] = 1;

            return result;
    }
}
